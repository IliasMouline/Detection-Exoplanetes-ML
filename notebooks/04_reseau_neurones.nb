Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "datasetEntrainementNormalise", "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"datasetEntrainementNormalise", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "ligne", ",", "vecteur", ",", "moyenne", ",", "ecartType", ",", 
           "vecteurNormalise"}], "}"}], ",", 
         RowBox[{
          RowBox[{"ligne", "=", "ligneOrig"}], ";", "\[IndentingNewLine]", 
          RowBox[{"vecteur", "=", 
           RowBox[{"ligne", "[", "\"\<Vecteur\>\"", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"moyenne", "=", 
           RowBox[{"Mean", "[", "vecteur", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"ecartType", "=", 
           RowBox[{"StandardDeviation", "[", "vecteur", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"vecteurNormalise", "=", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"vecteur", "-", "moyenne"}], ")"}], "/", "ecartType"}]}],
           ";", "\[IndentingNewLine]", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<kepid\>\"", "->", 
             RowBox[{"ligne", "[", "\"\<kepid\>\"", "]"}]}], ",", 
            RowBox[{"\"\<Disposition\>\"", "->", 
             RowBox[{"ligne", "[", "\"\<Disposition\>\"", "]"}]}], ",", 
            RowBox[{"\"\<Label\>\"", "->", 
             RowBox[{"ligne", "[", "\"\<Label\>\"", "]"}]}], ",", 
            RowBox[{"\"\<Vecteur\>\"", "->", "vecteurNormalise"}]}], 
           "|>"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"ligneOrig", ",", 
         RowBox[{"Normal", "[", "datasetEntrainement", "]"}]}], "}"}]}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Nombre d'\[EAcute]toiles normalis\[EAcute]es : \>\"", ",", 
      RowBox[{"Length", "[", "datasetEntrainementNormalise", "]"}]}], "]"}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"statsApresNormalisation", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<kepid\>\"", "->", 
          RowBox[{"etoile", "[", "\"\<kepid\>\"", "]"}]}], ",", 
         RowBox[{"\"\<Moyenne\>\"", "->", 
          RowBox[{"N", "[", 
           RowBox[{"Mean", "[", 
            RowBox[{"etoile", "[", "\"\<Vecteur\>\"", "]"}], "]"}], "]"}]}], ",", 
         RowBox[{"\"\<EcartType\>\"", "->", 
          RowBox[{"N", "[", 
           RowBox[{"StandardDeviation", "[", 
            RowBox[{"etoile", "[", "\"\<Vecteur\>\"", "]"}], "]"}], "]"}]}]}],
         "|>"}], ",", 
       RowBox[{"{", 
        RowBox[{"etoile", ",", "datasetEntrainementNormalise"}], "}"}]}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Moyenne des moyennes : \>\"", ",", 
      RowBox[{"N", "[", 
       RowBox[{"Mean", "[", 
        RowBox[{"statsApresNormalisation", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "\"\<Moyenne\>\""}], "]"}], "]"}], "]"}], 
       "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Moyenne des \[EAcute]carts-types : \>\"",
       ",", 
      RowBox[{"N", "[", 
       RowBox[{"Mean", "[", 
        RowBox[{"statsApresNormalisation", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "\"\<EcartType\>\""}], "]"}], "]"}], "]"}], 
       "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Min/Max des moyennes individuelles : \>\"", ",", 
      RowBox[{"MinMax", "[", 
       RowBox[{"statsApresNormalisation", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "\"\<Moyenne\>\""}], "]"}], "]"}], "]"}]}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Min/Max des \[EAcute]carts-types individuels : \>\"", ",", 
