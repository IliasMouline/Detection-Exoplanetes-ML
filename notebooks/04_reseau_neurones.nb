      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ConvolutionLayer", "[", 
          RowBox[{"8", ",", "7"}], "]"}], ",", 
         RowBox[{"ElementwiseLayer", "[", "Ramp", "]"}], ",", 
         RowBox[{"PoolingLayer", "[", 
          RowBox[{"4", ",", "4"}], "]"}], ",", 
         RowBox[{"DropoutLayer", "[", "0.3", "]"}], ",", 
         RowBox[{"FlattenLayer", "[", "]"}], ",", 
         RowBox[{"LinearLayer", "[", "8", "]"}], ",", 
         RowBox[{"ElementwiseLayer", "[", "Ramp", "]"}], ",", 
         RowBox[{"DropoutLayer", "[", "0.3", "]"}], ",", 
         RowBox[{"LinearLayer", "[", "2", "]"}], ",", 
         RowBox[{"SoftmaxLayer", "[", "]"}]}], "}"}], ",", 
       RowBox[{"\"\<Input\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", "201"}], "}"}]}], ",", 
       RowBox[{"\"\<Output\>\"", "->", 
        RowBox[{"NetDecoder", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<Class\>\"", ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}]}], "}"}], "]"}]}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"architectureRegularisee", "=", 
     RowBox[{"NetInitialize", "[", "architectureRegularisee", "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"resultatEntrainementV2", "=", 
     RowBox[{"NetTrain", "[", 
      RowBox[{"architectureRegularisee", ",", "donneesTrainNetNorm", ",", "All", ",", 
       RowBox[{"ValidationSet", "->", "donneesValidationNetNorm"}], ",", 
       RowBox[{"Method", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<ADAM\>\"", ",", 
