Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"resumeConfiance", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "ligne", ",", "vecteur", ",", "labelReel", ",", "probas", ",", 
           "predite", ",", "correcte"}], "}"}], ",", 
         RowBox[{
          RowBox[{"ligne", "=", "etoile"}], ";", "\[IndentingNewLine]", 
          RowBox[{"vecteur", "=", 
           RowBox[{"Lookup", "[", 
            RowBox[{"ligne", ",", "\"\<Vecteur\>\""}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"labelReel", "=", 
           RowBox[{"Lookup", "[", 
            RowBox[{"ligne", ",", "\"\<Label\>\""}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"probas", "=", 
           RowBox[{"modeleProbabilites", "[", 
            RowBox[{"{", "vecteur", "}"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"predite", "=", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"probas", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ">", 
              RowBox[{"probas", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ",", "1", ",", "0"}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"correcte", "=", 
           RowBox[{"(", 
            RowBox[{"predite", "==", "labelReel"}], ")"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<kepid\>\"", "->", 
             RowBox[{"Lookup", "[", 
              RowBox[{"ligne", ",", "\"\<kepid\>\""}], "]"}]}], ",", 
            RowBox[{"\"\<LabelReel\>\"", "->", "labelReel"}], ",", 
            RowBox[{"\"\<Predite\>\"", "->", "predite"}], ",", 
            RowBox[{"\"\<Correcte\>\"", "->", "correcte"}], ",", 
            RowBox[{"\"\<Confiance\>\"", "->", 
             RowBox[{"Round", "[", 
              RowBox[{"100", "*", 
               RowBox[{"Max", "[", "probas", "]"}]}], "]"}]}]}], "|>"}]}]}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"etoile", ",", 
         RowBox[{"Normal", "[", "ensembleEvalElargi", "]"}]}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"resumeTrie", "=", 
     RowBox[{"SortBy", "[", 
      RowBox[{"resumeConfiance", ",", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"#", "[", "\"\<Confiance\>\"", "]"}]}], "&"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<R\[EAcute]sum\[EAcute] tri\[EAcute] par confiance d\
\[EAcute]croissante :\>\"", "]"}], ";"}], "\n", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{"Print", "[", "ligne", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"ligne", ",", "resumeTrie"}], "}"}]}], "]"}]}]}]], "Input",
