      RowBox[{"Length", "[", "donneesValidationNetNorm", "]"}], 
      ",", "\"\< -- Test: \>\"", ",", 
      RowBox[{"Length", "[", "donneesTestNetNorm", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Clear", "[", "architectureCNN", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"architectureCNN", "=", 
     RowBox[{"NetChain", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ConvolutionLayer", "[", 
          RowBox[{"8", ",", "7"}], "]"}], ",", 
         RowBox[{"ElementwiseLayer", "[", "Ramp", "]"}], ",", 
         RowBox[{"PoolingLayer", "[", 
          RowBox[{"4", ",", "4"}], "]"}], ",", 
         RowBox[{"FlattenLayer", "[", "]"}], ",", 
         RowBox[{"LinearLayer", "[", "8", "]"}], ",", 
         RowBox[{"ElementwiseLayer", "[", "Ramp", "]"}], ",", 
         RowBox[{"LinearLayer", "[", "2", "]"}], ",", 
         RowBox[{"SoftmaxLayer", "[", "]"}]}], "}"}], ",", 
       RowBox[{"\"\<Input\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", "201"}], "}"}]}], ",", 
       RowBox[{"\"\<Output\>\"", "->", 
        RowBox[{"NetDecoder", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<Class\>\"", ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}]}], "}"}], "]"}]}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"architectureCNN", "=", 
     RowBox[{"NetInitialize", "[", "architectureCNN", "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"resultatEntrainement", "=", 
     RowBox[{"NetTrain", "[", 
      RowBox[{
      "architectureCNN", ",", "donneesTrainNetNorm", ",", "All", ",", 
       RowBox[{"ValidationSet", "->", "donneesValidationNetNorm"}], ",", 
       RowBox[{"MaxTrainingRounds", "->", "50"}], ",", 
       RowBox[{"TrainingProgressReporting", "->", "\"\<Panel\>\""}]}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"reseauEntraine", "=", 
     RowBox[{"resultatEntrainement", "[", "\"\<TrainedNet\>\"", "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"reseauProbabilites", "=", 
     RowBox[{"NetReplacePart", "[", 
      RowBox[{"reseauEntraine", ",", 
       RowBox[{"\"\<Output\>\"", "->", "Automatic"}]}], "]"}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{"probasTrain", "=", 
     RowBox[{"reseauProbabilites", "[", 
      RowBox[{"donneesTrainNetNorm", "[", 
       RowBox[{"[", 
