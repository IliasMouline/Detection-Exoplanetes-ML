       RowBox[{"2", ",", "1"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"vraisNegatifs", "=", 
     RowBox[{"matriceConfusion", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"precision", "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"vraisPositifs", "+", "fauxPositifs"}], ">", "0"}], ",", 
       RowBox[{"N", "[", 
        RowBox[{"vraisPositifs", "/", 
         RowBox[{"(", 
          RowBox[{"vraisPositifs", "+", "fauxPositifs"}], ")"}]}], "]"}], 
       ",", "\"\<N/A\>\""}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rappel", "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"vraisPositifs", "+", "fauxNegatifs"}], ">", "0"}], ",", 
       RowBox[{"N", "[", 
        RowBox[{"vraisPositifs", "/", 
         RowBox[{"(", 
          RowBox[{"vraisPositifs", "+", "fauxNegatifs"}], ")"}]}], "]"}], 
       ",", "\"\<N/A\>\""}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"f1Score", "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"NumericQ", "[", "precision", "]"}], "&&", 
        RowBox[{"NumericQ", "[", "rappel", "]"}], "&&", 
        RowBox[{
         RowBox[{"precision", "+", "rappel"}], ">", "0"}]}], ",", 
       RowBox[{"N", "[", 
        RowBox[{"2", "*", "precision", "*", 
         RowBox[{"rappel", "/", 
          RowBox[{"(", 
           RowBox[{"precision", "+", "rappel"}], ")"}]}]}], "]"}], 
       ",", "\"\<N/A\>\""}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Pr\[EAcute]cision (FALSE POSITIVE) : \>\"", ",", 
      "precision"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Rappel (FALSE POSITIVE) : \>\"", ",", "rappel"}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<F1-score : \>\"", ",", "f1Score"}], "]"}], 
    ";"}]}]}]], "Input",
