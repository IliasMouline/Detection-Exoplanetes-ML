Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"visualiserPrediction", "[", "kepidCible_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "ligne", ",", "vecteur", ",", "labelReel", ",", "probas", ",", 
        "predite", ",", "correcte", ",", "nomLabelReel", ",", 
        "nomLabelPredit", ",", "graphiqueCourbe", ",", "jaugeProba", ",", 
        "couleurVerdict", ",", "texteVerdict", ",", "panneauVerdict"}], "}"}],
       ",", 
      RowBox[{
       RowBox[{"ligne", "=", 
        RowBox[{"SelectFirst", "[", 
         RowBox[{
          RowBox[{"Normal", "[", "ensembleEvalElargi", "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Lookup", "[", 
             RowBox[{"#", ",", "\"\<kepid\>\""}], "]"}], "==", "kepidCible"}],
            "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"MissingQ", "[", "ligne", "]"}], ",", 
         RowBox[{"Return", "[", 
          
          RowBox[{"\"\<Aucune \[EAcute]toile trouv\[EAcute]e avec ce kepid : \
\>\"", "<>", 
           RowBox[{"ToString", "[", "kepidCible", "]"}]}], "]"}]}], "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"vecteur", "=", 
        RowBox[{"Lookup", "[", 
         RowBox[{"ligne", ",", "\"\<Vecteur\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"labelReel", "=", 
        RowBox[{"Lookup", "[", 
         RowBox[{"ligne", ",", "\"\<Label\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"probas", "=", 
        RowBox[{"modeleProbabilites", "[", 
         RowBox[{"{", "vecteur", "}"}], "]"}]}], ";", 
       RowBox[{"predite", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"probas", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ">", 
           RowBox[{"probas", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", "1", ",", "0"}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"correcte", "=", 
        RowBox[{"(", 
         RowBox[{"predite", "==", "labelReel"}], ")"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"nomLabelReel", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"labelReel", "==", "1"}], ",", "\"\<FAUX POSITIF\>\"", 
          ",", "\"\<CONFIRM\[CapitalEAcute]\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"nomLabelPredit", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"predite", "==", "1"}], ",", "\"\<FAUX POSITIF\>\"", 
          ",", "\"\<CONFIRM\[CapitalEAcute]\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"graphiqueCourbe", "=", 
        RowBox[{"ListLinePlot", "[", 
         RowBox[{"vecteur", ",", 
          RowBox[{"PlotLabel", "->", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"\"\<Courbe repli\[EAcute]e - KIC \>\"", "<>", 
              RowBox[{"ToString", "[", "kepidCible", "]"}]}], ",", "14", ",", 
             "Bold"}], "]"}]}], ",", 
          RowBox[{"AxesLabel", "->", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Indice du bin\>\"", 
             ",", "\"\<Flux normalis\[EAcute]\>\""}], "}"}]}], ",", 
          RowBox[{"PlotStyle", "->", 
           RowBox[{"{", 
            RowBox[{"Thick", ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"labelReel", "==", "1"}], ",", 
               RowBox[{"Darker", "[", "Red", "]"}], ",", 
               RowBox[{"Darker", "[", "Blue", "]"}]}], "]"}]}], "}"}]}], ",", 
          
          RowBox[{"ImageSize", "->", "400"}], ",", 
          RowBox[{"Frame", "->", "True"}], ",", 
          RowBox[{"GridLines", "->", "Automatic"}], ",", 
          RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"jaugeProba", "=", 
        RowBox[{"BarChart", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"probas", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"probas", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"ChartLabels", "->", 
           RowBox[{"{", 
            
            RowBox[{"\"\<P(CONFIRM\[CapitalEAcute])\>\"", 
             ",", "\"\<P(FAUX POSITIF)\>\""}], "}"}]}], ",", 
          RowBox[{"ChartStyle", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"RGBColor", "[", 
              RowBox[{"0.2", ",", "0.4", ",", "0.8"}], "]"}], ",", 
             RowBox[{"RGBColor", "[", 
              RowBox[{"0.85", ",", "0.3", ",", "0.2"}], "]"}]}], "}"}]}], ",", 
          RowBox[{"PlotLabel", "->", 
           RowBox[{"Style", "[", 
            
            RowBox[{"\"\<Confiance du mod\[EGrave]le\>\"", ",", "13", ",", 
             "Bold"}], "]"}]}], ",", 
          RowBox[{"BarOrigin", "->", "Left"}], ",", 
          RowBox[{"ImageSize", "->", "400"}], ",", 
          RowBox[{"AxesLabel", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<Probabilit\[EAcute]\>\"", ",", "None"}], "}"}]}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"couleurVerdict", "=", 
        RowBox[{"If", "[", 
         RowBox[{"correcte", ",", 
          RowBox[{"RGBColor", "[", 
