Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"modeleProbabilites", "=", 
     RowBox[{"NetReplacePart", "[", 
      RowBox[{"modele", ",", 
       RowBox[{"\"\<Output\>\"", "->", "Automatic"}]}], "]"}]}], ";"}], " ", 
   RowBox[{
    RowBox[{
     RowBox[{"visualiserPrediction", "[", "kepid_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "ligne", ",", "vecteur", ",", "labelReel", ",", "probas", ",", 
         "predite", ",", "correcte", ",", "nomLabelReel", ",", 
         "nomLabelPredit", ",", "graphiqueCourbe", ",", "jaugeProba", ",", 
         "couleurVerdict", ",", "texteVerdict", ",", "panneauVerdict"}], 
        "}"}], ",", 
       RowBox[{
        RowBox[{"ligne", "=", 
         RowBox[{
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"Normal", "[", "ensembleEvalElargi", "]"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", "\"\<kepid\>\"", "]"}], "==", "kepid"}], 
             "&"}]}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"vecteur", "=", 
         RowBox[{"ligne", "[", "\"\<Vecteur\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"labelReel", "=", 
         RowBox[{"ligne", "[", "\"\<Label\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"probas", "=", 
         RowBox[{"First", "[", 
          RowBox[{"modeleProbabilites", "[", 
           RowBox[{"{", "vecteur", "}"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"predite", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"probas", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ">", 
            RowBox[{"probas", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ",", "1", ",", "0"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"correcte", "=", 
         RowBox[{"(", 
          RowBox[{"predite", "==", "labelReel"}], ")"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"nomLabelReel", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"labelReel", "==", "1"}], ",", "\"\<FAUX POSITIF\>\"", 
           ",", "\"\<CONFIRM\[CapitalEAcute]\>\""}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"nomLabelPredit", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"predite", "==", "1"}], ",", "\"\<FAUX POSITIF\>\"", 
           ",", "\"\<CONFIRM\[CapitalEAcute]\>\""}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"graphiqueCourbe", "=", 
         RowBox[{"ListLinePlot", "[", 
          RowBox[{"vecteur", ",", 
           RowBox[{"PlotLabel", "->", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"\"\<Courbe repli\[EAcute]e - KIC \>\"", "<>", 
               RowBox[{"ToString", "[", "kepid", "]"}]}], ",", "14", ",", 
              "Bold"}], "]"}]}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             
             RowBox[{"\"\<Indice du bin\>\"", 
              ",", "\"\<Flux normalis\[EAcute]\>\""}], "}"}]}], ",", 
           RowBox[{"PlotStyle", "->", 
            RowBox[{"{", 
             RowBox[{"Thick", ",", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"labelReel", "==", "1"}], ",", 
                RowBox[{"Darker", "[", "Red", "]"}], ",", 
                RowBox[{"Darker", "[", "Blue", "]"}]}], "]"}]}], "}"}]}], ",", 
           RowBox[{"ImageSize", "->", "400"}], ",", 
           RowBox[{"Frame", "->", "True"}], ",", 
           RowBox[{"GridLines", "->", "Automatic"}], ",", 
           RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"jaugeProba", "=", 
         RowBox[{"BarChart", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"probas", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"probas", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
           RowBox[{"ChartLabels", "->", 
            RowBox[{"{", 
             
             RowBox[{"\"\<P(CONFIRM\[CapitalEAcute])\>\"", 
              ",", "\"\<P(FAUX POSITIF)\>\""}], "}"}]}], ",", 
           RowBox[{"ChartStyle", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"RGBColor", "[", 
               RowBox[{"0.2", ",", "0.4", ",", "0.8"}], "]"}], ",", 
              RowBox[{"RGBColor", "[", 
               RowBox[{"0.85", ",", "0.3", ",", "0.2"}], "]"}]}], "}"}]}], ",", 
           RowBox[{"PlotLabel", "->", 
            RowBox[{"Style", "[", 
             
             RowBox[{"\"\<Confiance du mod\[EGrave]le\>\"", ",", "13", ",", 
              "Bold"}], "]"}]}], ",", 
           RowBox[{"BarOrigin", "->", "Left"}], ",", 
           RowBox[{"ImageSize", "->", "400"}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<Probabilit\[EAcute]\>\"", ",", "None"}], "}"}]}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"couleurVerdict", "=", 
         RowBox[{"If", "[", 
          RowBox[{"correcte", ",", 
           RowBox[{"RGBColor", "[", 
            RowBox[{"0.85", ",", "0.95", ",", "0.85"}], "]"}], ",", 
           RowBox[{"RGBColor", "[", 
            RowBox[{"0.98", ",", "0.85", ",", "0.85"}], "]"}]}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"texteVerdict", "=", 
         RowBox[{"If", "[", 
          RowBox[{
          "correcte", 
           ",", "\"\<Pr\[EAcute]diction correcte\>\"", 
           ",", "\"\<Pr\[EAcute]diction incorrecte\>\""}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"panneauVerdict", "=", 
         RowBox[{"Framed", "[", 
          RowBox[{
           RowBox[{"Column", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{"texteVerdict", ",", "16", ",", "Bold", ",", 
                 RowBox[{"If", "[", 
                  RowBox[{"correcte", ",", 
                   RowBox[{"Darker", "[", "Green", "]"}], ",", 
                   RowBox[{"Darker", "[", "Red", "]"}]}], "]"}]}], "]"}], ",", 
               RowBox[{"Style", "[", 
                RowBox[{
                 
                 RowBox[{"\"\<Label r\[EAcute]el : \>\"", "<>", 
                  "nomLabelReel"}], ",", "13"}], "]"}], ",", 
               RowBox[{"Style", "[", 
                RowBox[{
                 
                 RowBox[{"\"\<Pr\[EAcute]diction du mod\[EGrave]le : \>\"", "<>",
                   "nomLabelPredit"}], ",", "13"}], "]"}], ",", 
               RowBox[{"Style", "[", 
                RowBox[{
                 RowBox[{"\"\<Confiance : \>\"", "<>", 
                  RowBox[{"ToString", "[", 
                   RowBox[{"Round", "[", 
                    RowBox[{"100", "*", 
                    RowBox[{"Max", "[", "probas", "]"}]}], "]"}], "]"}], "<>",
                   "\"\<%\>\""}], ",", "13", ",", "Italic"}], "]"}]}], "}"}], 
             ",", "Center", ",", "0.5"}], "]"}], ",", 
           RowBox[{"Background", "->", "couleurVerdict"}], ",", 
           RowBox[{"FrameMargins", "->", "15"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Column", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Row", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"graphiqueCourbe", ",", "jaugeProba"}], "}"}], ",", 
              RowBox[{"Spacer", "[", "20", "]"}]}], "]"}], ",", 
            "panneauVerdict"}], "}"}], ",", "Center", ",", "15"}], "]"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"visualiserPrediction", "[", "11905011", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.992317173070167*^9, 3.992317173072027*^9}},
