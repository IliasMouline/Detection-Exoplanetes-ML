Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"reseauProbabilitesV2", "=", 
     RowBox[{"NetReplacePart", "[", 
      RowBox[{"reseauEntraineV2", ",", 
       RowBox[{"\"\<Output\>\"", "->", "Automatic"}]}], "]"}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{"probasTestV2", "=", 
     RowBox[{"reseauProbabilitesV2", "[", 
      RowBox[{"donneesTestNetNorm", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<--- D\[EAcute]tail des 6 \[EAcute]toiles de test ---\>\
\"", "]"}], ";"}], "\n", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"\"\<\[CapitalEAcute]toile \>\"", ",", "i", 
       ",", "\"\< -- Label r\[EAcute]el: \>\"", ",", 
       RowBox[{"labelsTest", "[", 
        RowBox[{"[", "i", "]"}], "]"}], 
       ",", "\"\< -- Pr\[EAcute]diction: \>\"", ",", 
       RowBox[{"predictionsTestV2", "[", 
        RowBox[{"[", "i", "]"}], "]"}], 
       ",", "\"\< -- Probas [P(0),P(1)]: \>\"", ",", 
       RowBox[{"probasTestV2", "[", 
        RowBox[{"[", "i", "]"}], "]"}], ",", "\"\< -- \>\"", ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"labelsTest", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "==", 
          RowBox[{"predictionsTestV2", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], 
         ",", "\"\<correct\>\"", ",", "\"\<erreur\>\""}], 
        "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "6"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"resultatsMultiSeeds", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"SeedRandom", "[", "graine", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"archTemp", "=", 
         RowBox[{"NetInitialize", "[", "architectureRegularisee", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"resTemp", "=", 
         RowBox[{"NetTrain", "[", 
          RowBox[{"archTemp", ",", "donneesTrainNetNorm", ",", "All", ",", 
           RowBox[{"ValidationSet", "->", "donneesValidationNetNorm"}], ",", 
           RowBox[{"Method", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<ADAM\>\"", ",", 
              RowBox[{"\"\<L2Regularization\>\"", "->", "0.01"}]}], "}"}]}], ",", 
           RowBox[{"MaxTrainingRounds", "->", "50"}], ",", 
           RowBox[{"TrainingProgressReporting", "->", "None"}]}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"reseauTemp", "=", 
         RowBox[{"resTemp", "[", "\"\<TrainedNet\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"predVal", "=", 
         RowBox[{"reseauTemp", "[", 
          RowBox[{"donneesValidationNetNorm", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"predTest", "=", 
         RowBox[{"reseauTemp", "[", 
          RowBox[{"donneesTestNetNorm", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Graine\>\"", "->", "graine"}], ",", 
          RowBox[{"\"\<AccVal\>\"", "->", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"Count", "[", 
              RowBox[{
               RowBox[{"MapThread", "[", 
                RowBox[{"Equal", ",", 
                 RowBox[{"{", 
                  RowBox[{"predVal", ",", "labelsValidation"}], "}"}]}], 
                "]"}], ",", "True"}], "]"}], "/", "7"}], "]"}]}], ",", 
          RowBox[{"\"\<AccTest\>\"", "->", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"Count", "[", 
              RowBox[{
               RowBox[{"MapThread", "[", 
                RowBox[{"Equal", ",", 
                 RowBox[{"{", 
                  RowBox[{"predTest", ",", "labelsTest"}], "}"}]}], "]"}], ",",
                "True"}], "]"}], "/", "6"}], "]"}]}]}], "|>"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"graine", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "2", ",", "3", ",", "42", ",", "100"}], "}"}]}], 
        "}"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"Dataset", "[", "resultatsMultiSeeds", "]"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Accuracy test - Moyenne sur 5 graines : \>\"", ",", 
      RowBox[{"N", "[", 
       RowBox[{"Mean", "[", 
        RowBox[{"resultatsMultiSeeds", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "\"\<AccTest\>\""}], "]"}], "]"}], "]"}], 
       "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Accuracy test - Min/Max sur 5 graines : \>\"", ",", 
      RowBox[{"MinMax", "[", 
       RowBox[{"resultatsMultiSeeds", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "\"\<AccTest\>\""}], "]"}], "]"}], "]"}]}], 
     "]"}], ";"}]}]}]], "Input",
