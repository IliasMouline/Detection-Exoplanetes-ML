Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], " ", 
   RowBox[{
    RowBox[{"donneesCompletes", "=", 
     RowBox[{"Normal", "[", "datasetEntrainement", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"groupeConfirmed", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"donneesCompletes", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", "\"\<Label\>\"", "]"}], "==", "0"}], "&"}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"groupeFalsePos", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"donneesCompletes", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", "\"\<Label\>\"", "]"}], "==", "1"}], "&"}]}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Taille groupe CONFIRMED (label 0) : \>\"", ",", 
      RowBox[{"Length", "[", "groupeConfirmed", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Taille groupe FALSE POSITIVE (label 1) : \>\"", ",", 
      RowBox[{"Length", "[", "groupeFalsePos", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"splitStratifie", "[", "liste_List", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"n", ",", "nTrain", ",", "nVal", ",", "permutee"}], "}"}], ",", 
       RowBox[{
        RowBox[{"n", "=", 
         RowBox[{"Length", "[", "liste", "]"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"nTrain", "=", 
         RowBox[{"Round", "[", 
          RowBox[{"0.70", "*", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"nVal", "=", 
         RowBox[{"Round", "[", 
          RowBox[{"0.15", "*", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"permutee", "=", 
         RowBox[{"RandomSample", "[", "liste", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Train\>\"", "->", 
           RowBox[{"permutee", "[", 
            RowBox[{"[", 
             RowBox[{"1", ";;", "nTrain"}], "]"}], "]"}]}], ",", 
          RowBox[{"\"\<Validation\>\"", "->", 
           RowBox[{"permutee", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"nTrain", "+", "1"}], ";;", 
              RowBox[{"nTrain", "+", "nVal"}]}], "]"}], "]"}]}], ",", 
          RowBox[{"\"\<Test\>\"", "->", 
           RowBox[{"permutee", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"nTrain", "+", "nVal", "+", "1"}], ";;"}], "]"}], 
            "]"}]}]}], "|>"}]}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"splitConfirmed", "=", 
     RowBox[{"splitStratifie", "[", "groupeConfirmed", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"splitFalsePos", "=", 
     RowBox[{"splitStratifie", "[", "groupeFalsePos", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"ensembleTrain", "=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"splitConfirmed", "[", "\"\<Train\>\"", "]"}], ",", 
       RowBox[{"splitFalsePos", "[", "\"\<Train\>\"", "]"}]}], "]"}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"ensembleValidation", "=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"splitConfirmed", "[", "\"\<Validation\>\"", "]"}], ",", 
       RowBox[{"splitFalsePos", "[", "\"\<Validation\>\"", "]"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"ensembleTest", "=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"splitConfirmed", "[", "\"\<Test\>\"", "]"}], ",", 
       RowBox[{"splitFalsePos", "[", "\"\<Test\>\"", "]"}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<--- R\[EAcute]sultat du split stratifi\[EAcute] \
---\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Train : \>\"", ",", 
      RowBox[{"Length", "[", "ensembleTrain", "]"}], 
      ",", "\"\< \[EAcute]toiles -- r\[EAcute]partition labels : \>\"", ",", 
      RowBox[{"Counts", "[", 
       RowBox[{"ensembleTrain", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "\"\<Label\>\""}], "]"}], "]"}], "]"}]}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Validation : \>\"", ",", 
      RowBox[{"Length", "[", "ensembleValidation", "]"}], 
      ",", "\"\< \[EAcute]toiles -- r\[EAcute]partition labels : \>\"", ",", 
