Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "architectureCNNTest", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"architectureCNNTest", "=", 
     RowBox[{"NetChain", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ConvolutionLayer", "[", 
          RowBox[{"8", ",", "7"}], "]"}], ",", 
         RowBox[{"ElementwiseLayer", "[", "Ramp", "]"}], ",", 
         RowBox[{"PoolingLayer", "[", 
          RowBox[{"4", ",", "4"}], "]"}], ",", 
         RowBox[{"FlattenLayer", "[", "]"}], ",", 
         RowBox[{"LinearLayer", "[", "8", "]"}], ",", 
         RowBox[{"ElementwiseLayer", "[", "Ramp", "]"}], ",", 
         RowBox[{"LinearLayer", "[", "2", "]"}], ",", 
         RowBox[{"SoftmaxLayer", "[", "]"}]}], "}"}], ",", 
       RowBox[{"\"\<Input\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", "201"}], "}"}]}], ",", 
       RowBox[{"\"\<Output\>\"", "->", 
        RowBox[{"NetDecoder", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<Class\>\"", ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}]}], "}"}], "]"}]}]}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"architectureCNNTest", "=", 
     RowBox[{"NetInitialize", "[", "architectureCNNTest", "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"resultatTest", "=", 
     RowBox[{"NetTrain", "[", 
      RowBox[{
      "architectureCNNTest", ",", "donneesTrainNet", ",", "All", ",", 
       RowBox[{"ValidationSet", "->", "donneesValidationNet"}], ",", 
       RowBox[{"MaxTrainingRounds", "->", "100"}], ",", 
       RowBox[{"TrainingProgressReporting", "->", "\"\<Panel\>\""}]}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"reseauTest", "=", 
     RowBox[{"resultatTest", "[", "\"\<TrainedNet\>\"", "]"}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{"predictionsTrainTest", "=", 
     RowBox[{"reseauTest", "[", 
      RowBox[{"donneesTrainNet", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<R\[EAcute]partition des pr\[EAcute]dictions sur train : \>\"", ",", 
      RowBox[{"Counts", "[", "predictionsTrainTest", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Accuracy train : \>\"", ",", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"Count", "[", 
         RowBox[{
          RowBox[{"MapThread", "[", 
           RowBox[{"Equal", ",", 
            RowBox[{"{", 
             RowBox[{"predictionsTrainTest", ",", 
              RowBox[{"donneesTrainNet", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "}"}]}], "]"}], ",",
           "True"}], "]"}], "/", "31"}], "]"}]}], "]"}], ";"}]}]}]], "Input",
