Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"exporterEnsemble", "[", 
      RowBox[{"ensemble_", ",", "nomDossier_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"chemin", ",", "verif"}], "}"}], ",", 
       RowBox[{
        RowBox[{"chemin", "=", 
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{
           "racineProjet", ",", "\"\<data\>\"", ",", "\"\<processed\>\"", ",",
             "nomDossier", ",", 
            
            RowBox[{"\"\<dataset_\>\"", "<>", "nomDossier", 
             "<>", "\"\<_44etoiles.wxf\>\""}]}], "}"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Export", "[", 
         RowBox[{"chemin", ",", "ensemble"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"verif", "=", 
         RowBox[{"Import", "[", "chemin", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Dossier\>\"", "->", "nomDossier"}], ",", 
          RowBox[{"\"\<CheminExport\>\"", "->", "chemin"}], ",", 
          RowBox[{"\"\<NbEtoilesExportees\>\"", "->", 
           RowBox[{"Length", "[", "ensemble", "]"}]}], ",", 
          RowBox[{"\"\<NbEtoilesRechargees\>\"", "->", 
           RowBox[{"Length", "[", "verif", "]"}]}], ",", 
          RowBox[{"\"\<Identique\>\"", "->", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Normal", "[", "verif", "]"}], "===", "ensemble"}], 
            ")"}]}]}], "|>"}]}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"resultatsExport", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"exporterEnsemble", "[", 
        RowBox[{"ensembleTrain", ",", "\"\<train\>\""}], "]"}], ",", 
       RowBox[{"exporterEnsemble", "[", 
        RowBox[{"ensembleValidation", ",", "\"\<validation\>\""}], "]"}], ",", 
       RowBox[{"exporterEnsemble", "[", 
        RowBox[{"ensembleTest", ",", "\"\<test\>\""}], "]"}]}], "}"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"Dataset", "[", "resultatsExport", "]"}]}]}]], "Input",
