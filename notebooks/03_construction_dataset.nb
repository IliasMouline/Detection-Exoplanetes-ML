   RowBox[{
    RowBox[{"resultatsVerification", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "existe", ",", "tailleFichier", ",", "contenuLisible", ",", 
           "nbElements", ",", "erreur"}], "}"}], ",", 
         RowBox[{
          RowBox[{"existe", "=", 
           RowBox[{"FileExistsQ", "[", "chemin", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"tailleFichier", "=", 
           RowBox[{"If", "[", 
            RowBox[{"existe", ",", 
             RowBox[{"FileByteCount", "[", "chemin", "]"}], ",", "0"}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"contenuLisible", ",", "nbElements", ",", "erreur"}], 
            "}"}], "=", 
           RowBox[{"If", "[", 
            RowBox[{"existe", ",", 
             RowBox[{"Quiet", "@", 
              RowBox[{"Check", "[", 
               RowBox[{
                RowBox[{"Module", "[", 
                 RowBox[{
                  RowBox[{"{", "c", "}"}], ",", 
                  RowBox[{
                   RowBox[{"c", "=", 
                    RowBox[{"Import", "[", "chemin", "]"}]}], ";", 
                   RowBox[{"{", 
                    RowBox[{"True", ",", 
                    RowBox[{"Length", "[", "c", "]"}], ",", "None"}], 
                    "}"}]}]}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{
                 "False", ",", "0", ",", "\"\<ERREUR A L'IMPORT\>\""}], 
                 "}"}]}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"False", ",", "0", ",", "\"\<FICHIER ABSENT\>\""}], 
              "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Fichier\>\"", "->", 
             RowBox[{"FileNameTake", "[", "chemin", "]"}]}], ",", 
            RowBox[{"\"\<Existe\>\"", "->", "existe"}], ",", 
            RowBox[{"\"\<TailleOctets\>\"", "->", "tailleFichier"}], ",", 
            RowBox[{"\"\<LisibleEtNonVide\>\"", "->", 
             RowBox[{"contenuLisible", "&&", 
              RowBox[{"nbElements", ">", "0"}]}]}], ",", 
            RowBox[{"\"\<NbElements\>\"", "->", "nbElements"}], ",", 
            RowBox[{"\"\<Probleme\>\"", "->", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"existe", "&&", "contenuLisible", "&&", 
                RowBox[{"nbElements", ">", "0"}]}], ",", "\"\<Aucun\>\"", ",",
                "erreur"}], "]"}]}]}], "|>"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"chemin", ",", "fichiersAttendus"}], "}"}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"resultatsVerification", "=", 
     RowBox[{"Dataset", "[", "resultatsVerification", "]"}]}], ";"}], "\n", 
   "resultatsVerification", "\[IndentingNewLine]", "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tousOK", "=", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"Normal", "[", "resultatsVerification", "]"}], ",", 
       RowBox[{
        RowBox[{"#", "[", "\"\<LisibleEtNonVide\>\"", "]"}], "&"}]}], "]"}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Tous les fichiers sont-ils pr\[EAcute]sents, lisibles et \
non vides ? \>\"", ",", "tousOK"}], "]"}], ";"}], "\n", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"!", "tousOK"}], ",", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Fichiers manquants ou illisibles : \>\"", ",", 
       
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Normal", "[", "resultatsVerification", "]"}], ",", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"#", "[", "\"\<LisibleEtNonVide\>\"", "]"}]}], "&"}]}], 
         "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "\"\<Fichier\>\""}], "]"}], "]"}]}], "]"}]}], 
    "]"}]}]}]], "Input",
