       RowBox[{"Length", "[", "ensembleValidation", "]"}], "+", 
       RowBox[{"Length", "[", "ensembleTest", "]"}]}], ",", "\"\< / 44\>\""}],
      "]"}], ";"}]}]}]], "Input",
