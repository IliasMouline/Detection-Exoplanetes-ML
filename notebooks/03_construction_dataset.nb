 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "architectureCNN", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"architectureCNN", "=", 
     RowBox[{"NetChain", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ConvolutionLayer", "[", 
          RowBox[{"16", ",", "5"}], "]"}], ",", 
         RowBox[{"BatchNormalizationLayer", "[", "]"}], ",", 
