    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Test : \>\"", ",", 
      RowBox[{"Length", "[", "ensembleTest", "]"}], 
      ",", "\"\< \[EAcute]toiles -- r\[EAcute]partition labels : \>\"", ",", 
      RowBox[{"Counts", "[", 
       RowBox[{"ensembleTest", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "\"\<Label\>\""}], "]"}], "]"}], "]"}]}], "]"}], 
