         RowBox[{"PoolingLayer", "[", 
          RowBox[{"2", ",", "2"}], "]"}], ",", 
         RowBox[{"ConvolutionLayer", "[", 
          RowBox[{"32", ",", "5"}], "]"}], ",", 
         RowBox[{"BatchNormalizationLayer", "[", "]"}], ",", 
         RowBox[{"ElementwiseLayer", "[", "Ramp", "]"}], ",", 
         RowBox[{"PoolingLayer", "[", 
          RowBox[{"2", ",", "2"}], "]"}], ",", 
         RowBox[{"FlattenLayer", "[", "]"}], ",", 
         RowBox[{"LinearLayer", "[", "32", "]"}], ",", 
         RowBox[{"ElementwiseLayer", "[", "Ramp", "]"}], ",", 
         RowBox[{"LinearLayer", "[", "1", "]"}], ",", "LogisticSigmoid"}], 
        "}"}], ",", 
       RowBox[{"\"\<Input\>\"", "->", 
